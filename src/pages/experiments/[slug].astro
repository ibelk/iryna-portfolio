---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WritingCard from '../../components/WritingCard.astro';

export async function getStaticPaths() {
  const items = await getCollection('experiments');
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'experiments'>;
}
const { entry } = Astro.props;
const { title, subtitle, intro, status, meta, entries, gallery, listsPosts, wipCards } = entry.data;

// Each tool write-up is its own on-site article; this page just links out to
// the ones that belong to it (matched by parentHref) as writing cards.
const articles = listsPosts
  ? (await getCollection('articles'))
      .filter(
        (a) =>
          a.data.parentHref === `/experiments/${entry.slug}` ||
          a.data.crossListedIn.includes(entry.slug),
      )
      .sort((a, b) => a.data.order - b.data.order)
  : [];
---

<BaseLayout title={`${title} — Iryna Belkova`}>
  <Header />

  <main>
    <div class="container page-crumb">
      <Breadcrumbs parentLabel="Experiments" parentHref="/#experiments" current={title} />
    </div>
    <section class="container page-head">
      <div class="page-head__text">
        <h1 class="page-head__title">{title}</h1>
        <p class="page-head__subtitle">{subtitle}</p>
        {status === 'wip' && <span class="wip">Work in progress</span>}
      </div>
    </section>

    {
      entries.length > 0 && (
        <section class="container entries">
          {entries.map((item) => (
            <article class="entry">
              <h2 class="entry__title">{item.title}</h2>
              <p class="entry__description">{item.description}</p>
            </article>
          ))}
        </section>
      )
    }

    {
      (articles.length > 0 || wipCards.length > 0) && (
        <section class="container entries entries--cards">
          {articles.map((article) => (
            <WritingCard
              title={article.data.heroTitle ?? article.data.title}
              image={article.data.cardImage}
              href={`/experiments/articles/${article.slug}/`}
              tags={[]}
            />
          ))}
          {wipCards.map((card) => (
            <div class="wip-card">
              <div class="wip-card__media">
                <img src={card.image} alt="" loading="lazy" decoding="async" />
              </div>
              <div class="wip-card__body">
                <h3 class="wip-card__title">{card.title}</h3>
              </div>
            </div>
          ))}
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section class="container gallery">
          {gallery.map((item) => (
            <figure
              class:list={['piece', { 'piece--wide': item.tall }]}
              style={item.background ? `background:${item.background}` : undefined}
            >
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            </figure>
          ))}
        </section>
      )
    }

    {
      entries.length === 0 && articles.length === 0 && wipCards.length === 0 && gallery.length === 0 && (
        <section class="container">
          <p class="empty">Selected pieces are being written up.</p>
        </section>
      )
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Breadcrumb row sits right under the header with the same 16px padding
     used on every other page (case studies included) — it was previously
     folded into .page-head's own padding-block-start, which used the much
     larger --space-section-y and pushed the crumb noticeably lower than it
     sits everywhere else on the site. */
  .page-crumb {
    padding-block: 0;
  }

  @media (min-width: 1024px) {
    .page-crumb {
      padding-block: var(--space-sm-static);
    }
  }

  /* Hero's own top padding (36px, Figma's Hero row) stacks with the crumb's
     16px bottom padding above for a 52px seam — not the 24px spacing-ladder
     step. */
  .page-head {
    display: flex;
    flex-direction: column;
    padding-block-start: var(--space-block-gap);
    padding-block-end: var(--space-block-gap);
  }

  /* Figma keeps the hero-to-cards gap at a fixed 36px (space-block-gap) on
     both sides of the seam, not the larger section-to-section rhythm — the
     cards row reads as part of the hero, not a new section. */
  .page-head + section {
    padding-top: var(--space-block-gap);
  }

  /* 24px between title and subtitle, matching the design — cap-height trimming
     removes the font's own leading, so a smaller gap reads as collapsed. */
  .page-head__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg-static);
  }

  .page-head__title {
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
  }

  .page-head__subtitle {
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .page-head__intro {
    max-width: 68ch;
    color: var(--color-text-secondary);
  }

  .wip {
    padding: var(--space-tag-y) var(--space-tag-x);
    border-radius: var(--radius-control);
    background: var(--color-surface-subtle);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg-static);
    padding-block: var(--space-section-y);
  }

  .meta__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs-static);
    padding-bottom: var(--space-lg-static);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .meta__row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .meta__label {
    font-size: var(--text-body);
    color: var(--color-text-muted);
  }

  .meta__value {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }

  .entries {
    display: grid;
    gap: var(--space-grid-gap);
    padding-block: var(--space-section-y);
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-static);
    padding: var(--space-cta-inset);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  .entry--link {
    transition: opacity var(--motion-fast) var(--motion-ease);
  }

  .entry--link:hover {
    opacity: var(--opacity-hover);
  }

  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-tag-gap);
  }

  .entry__title {
    font-size: var(--text-title-s);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
  }

  .entry__description {
    color: var(--color-text-secondary);
  }

  .entry__cta {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .empty {
    color: var(--color-text-muted);
    padding-block: var(--space-section-y);
  }

  /* Not-yet-written card — same shape as WritingCard, but dimmed and
     unlinked, matching Figma's "Design System AI Agent (WIP)" placeholder. */
  .wip-card {
    display: flex;
    flex-direction: column;
    gap: var(--size-8);
    padding: var(--space-card-padding);
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  /* The cover image already has the blur/soft-focus and "WIP" watermark
     baked in — a CSS blur+grayscale+opacity on top of that (as before)
     pushed it past legible into a near-solid color block. */
  .wip-card__media {
    height: 232px;
    overflow: hidden;
    border-radius: var(--radius-media-post);
  }

  .wip-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wip-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-card-text-gap);
    padding: var(--space-card-inset-md);
  }

  .wip-card__title {
    font-size: var(--text-title-s);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .wip-card__media {
      height: 263px;
    }
  }

  .gallery {
    display: grid;
    gap: var(--space-xl-static);
    padding-block: var(--space-section-y);
  }

  .piece {
    margin: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  /* A piece mounted on a coloured card is inset so the colour frames it; a
     full-bleed piece fills its own row. */
  .piece[style] {
    padding: var(--space-xl-static);
  }

  .piece img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
  }

  @media (min-width: 1024px) {
    .entries {
      grid-template-columns: repeat(2, 1fr);
    }

    .entries--cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
