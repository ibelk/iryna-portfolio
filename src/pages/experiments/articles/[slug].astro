---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const items = await getCollection('articles');
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { title, heroTitle, parentLabel, parentHref, intro, blocks } = entry.data;
const displayTitle = heroTitle ?? title;
---

<BaseLayout title={`${title} — Iryna Belkova`}>
  <Header />

  <main class="article">
    <div class="container article__crumb">
      <Breadcrumbs parentLabel={parentLabel} parentHref={parentHref} current={displayTitle} />
    </div>

    <header class="container article__hero">
      <h1>{displayTitle}</h1>
      {intro.map((p) => <p class="article__intro">{p}</p>)}
    </header>

    <div class="container article__body">
      {
        blocks.map((block) => {
          if (block.type === 'image') {
            return (
              <figure class="article__figure">
                <img src={block.src} alt={block.alt} loading="lazy" decoding="async" />
              </figure>
            );
          }
          if (block.type === 'gallery') {
            return (
              <div class="article__gallery">
                {block.images.map((img) => (
                  <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                ))}
              </div>
            );
          }
          if (block.type === 'progress') {
            return (
              <div class="article__progress">
                <div class="article__progress-bar">
                  {block.steps.map(() => <span class="article__progress-segment" />)}
                </div>
                <div class="article__progress-steps">
                  {block.steps.map((step) => <span>{step}</span>)}
                </div>
              </div>
            );
          }
          return (
            <section class="article__section">
              {block.heading && <h2>{block.heading}</h2>}
              {block.paragraphs.map((p) => <p>{p}</p>)}
              {block.bullets.length > 0 && (
                <ul>
                  {block.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </section>
          );
        })
      }
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article {
    display: block;
  }

  .article__crumb {
    padding-block: var(--space-sm-static);
  }

  .article__hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm-static);
    padding-block: var(--space-lg-static) var(--space-xl-static);
  }

  /* Smaller than the case-study display size (54px): these hero titles are
     full questions/sentences, not 1-3 word headings, and at the case-study
     size none of them fit their line at any reasonable container width —
     confirmed the longest needs 1259px at 54px. 46px keeps every current
     title comfortably on one line within the page's 1200px content width. */
  .article__hero h1 {
    font-size: var(--text-display-case);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
    letter-spacing: -0.01em;
  }

  @media (min-width: 1024px) {
    .article__hero h1 {
      font-size: 42px;
    }
  }

  .article__intro {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }

  .article__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl-static);
    padding-bottom: var(--space-section-y);
  }

  .article__figure {
    margin: 0;
  }

  .article__figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .article__gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md-static);
  }

  .article__gallery img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  .article__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm-static);
    max-width: 800px;
    margin-inline: auto;
    width: 100%;
  }

  .article__section h2 {
    font-size: var(--text-title-l);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
  }

  .article__section p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }

  .article__section ul {
    margin: 0;
    padding-left: var(--space-md-static);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs-static);
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }

  .article__section ul li::marker {
    color: var(--color-accent);
  }

  /* Segmented progress bar over a row of step labels, wrapped in the same
     dark card shell as the Development Process section on the Leaf case
     study — Figma puts the bar and steps inside a padded surface panel,
     not bare on the page background. */
  .article__progress {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: var(--space-panel-inset);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .article__progress-bar {
    display: flex;
    gap: 10px;
  }

  .article__progress-segment {
    flex: 1;
    height: 20px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  /* Figma fades the bar from the earliest step (dimmest) to the current one
     (full opacity), all on the same accent fill. */
  .article__progress-segment:nth-child(1) { opacity: 0.4; }
  .article__progress-segment:nth-child(2) { opacity: 0.5; }
  .article__progress-segment:nth-child(3) { opacity: 0.8; }
  .article__progress-segment:nth-child(n+4) { opacity: 0.9; }

  .article__progress-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm-static);
  }

  .article__progress-steps span {
    color: var(--color-text-primary);
    font-size: 16px;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
  }

  @media (min-width: 1024px) {
    .article__hero {
      padding-block: var(--space-section-y-lg) var(--space-xl-static);
    }

    .article__gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .article__progress-steps {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: var(--space-xs-static);
    }
  }
</style>
