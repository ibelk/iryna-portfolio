      gap: var(--space-md-static);
    }
    .ap-split.ap-panel { gap: var(--space-md-static); }
    .ap-split__sub { margin-top: var(--space-lg-static); }
    .ap-panel { padding: var(--space-panel-inset); }
    .ap-badge {
      padding: var(--space-xs-static) var(--space-sm-static);
      font-size: var(--text-body);
