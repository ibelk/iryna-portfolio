---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Ported from Figma "Web-portfolio" / frame Analytical-platform-1920 (181:13347).
// Text-analytical blocks are rebuilt in HTML on the token layer; the four chart
// showcase blocks (RTT, comparison, adaptive, design system) are exported design
// frames served as images. See docs — mobile-native version tracked separately.
const title = 'Infrastructure solution for analytical platform';
const subtitle =
  'Complex data adaptive graphics and a design system with long-term support';

const meta = [
  { label: 'Product', value: 'Analytical platform (web, data-heavy)' },
  { label: 'Scale', value: 'Startup → Break-even point' },
  { label: 'Data', value: 'High-density information charts' },
  { label: 'Environment', value: 'Continuous development and change of the team' },
];

const contextCards = [
  { title: 'User behavior', bullets: ['Comparing large amounts of data', 'High sensitivity to delays and UI noise'] },
  { title: 'Team', bullets: ['Designers were changing', 'Long-term support without the system author'] },
  { title: 'Process', bullets: ['Startup environment', 'Limited resources', 'Product growth without full redesign'] },
  { title: 'Constraints', bullets: ['Web platform', 'Real-time data', 'Browser performance limits'] },
];

const problems = [
  { title: 'High cognitive load', desc: 'Many visual elements at the same time (charts, histograms, lists, toolbars)' },
  { title: 'No clear focus hierarchy', desc: 'Unstructured information density. Data with different importance looks the same. It is hard to separate signal from noise.' },
  { title: 'Limited UI scalability', desc: 'Interface does not adapt to different number of active tools and different analysis scenarios.' },
];

const principles = [
  { title: 'Data-first interface', desc: 'Design decisions focus on readability and fast data analysis.' },
  { title: 'System scalability', desc: 'Architecture supports growth of data and features.' },
  { title: 'Design without manual support', desc: 'Consistency is controlled by rules and components.' },
  { title: 'Focused on experienced users', desc: 'High information density but still manageable.' },
];

const horizon = [
  { n: '01', desc: 'Component-based architecture instead of static screens. Unified rules for complex screens and data.' },
  { n: '02', desc: 'Flexible structure supports product growth. New features were added without rebuilding core screens.' },
  { n: '03', desc: 'The system has been used for 4 years. The product continued to grow without constant design support.' },
];

// Icon glyphs from the Block/List/Item "Type=Icon" component (Icon/Category,
// Icon/Profile, Icon/Cursor) — inlined as raw SVG so they inherit color via
// currentColor instead of depending on an exported asset file.
const iconCategory = `<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.24 0H3.34C1.15 0 0 1.15 0 3.33V5.23C0 7.41 1.15 8.56 3.33 8.56H5.23C7.41 8.56 8.56 7.41 8.56 5.23V3.33C8.57 1.15 7.42 0 5.24 0Z" fill="currentColor"/><path d="M16.67 0H14.77C12.59 0 11.44 1.15 11.44 3.33V5.23C11.44 7.41 12.59 8.56 14.77 8.56H16.67C18.85 8.56 20 7.41 20 5.23V3.33C20 1.15 18.85 0 16.67 0Z" fill="currentColor"/><path d="M16.67 11.43H14.77C12.59 11.43 11.44 12.58 11.44 14.76V16.66C11.44 18.84 12.59 19.99 14.77 19.99H16.67C18.85 19.99 20 18.84 20 16.66V14.76C20 12.58 18.85 11.43 16.67 11.43Z" fill="currentColor"/><path d="M5.24 11.43H3.34C1.15 11.43 0 12.58 0 14.76V16.66C0 18.85 1.15 20 3.33 20H5.23C7.41 20 8.56 18.85 8.56 16.67V14.77C8.57 12.58 7.42 11.43 5.24 11.43Z" fill="currentColor"/></svg>`;
const iconProfile = `<svg viewBox="0 0 14.08 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.04004 0C4.42004 0 2.29004 2.13 2.29004 4.75C2.29004 7.32 4.30004 9.4 6.92004 9.49C7.00004 9.48 7.08004 9.48 7.14004 9.49C7.16004 9.49 7.17004 9.49 7.19004 9.49C7.20004 9.49 7.20004 9.49 7.21004 9.49C9.77004 9.4 11.78 7.32 11.79 4.75C11.79 2.13 9.66004 0 7.04004 0Z" fill="currentColor"/><path d="M12.12 12.15C9.33 10.29 4.78 10.29 1.97 12.15C0.7 13 0 14.15 0 15.38C0 16.61 0.7 17.75 1.96 18.59C3.36 19.53 5.2 20 7.04 20C8.88 20 10.72 19.53 12.12 18.59C13.38 17.74 14.08 16.6 14.08 15.36C14.07 14.13 13.38 12.99 12.12 12.15Z" fill="currentColor"/></svg>`;
const iconCursor = `<svg viewBox="0 0 18.1205 18.1205" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.495 7.82371L10.3245 10.062C10.2628 10.0813 10.2067 10.1153 10.1609 10.161C10.1152 10.2068 10.0812 10.263 10.0619 10.3247L7.82371 17.495C7.76609 17.6729 7.65472 17.8286 7.50494 17.9405C7.35517 18.0525 7.17436 18.1153 6.98743 18.1202C6.80049 18.1252 6.61662 18.072 6.46114 17.9681C6.30566 17.8642 6.18623 17.7147 6.11928 17.54L0.0528721 1.21102C-0.00488394 1.04945 -0.0155743 0.8748 0.0220447 0.707392C0.0596637 0.539984 0.144046 0.3867 0.265373 0.265373C0.3867 0.144046 0.539984 0.0596637 0.707392 0.0220447C0.8748 -0.0155743 1.04945 -0.00488394 1.21102 0.0528721L17.5402 6.11928C17.7148 6.18625 17.8643 6.3057 17.9682 6.46119C18.0721 6.61667 18.1252 6.80054 18.1202 6.98747C18.1153 7.1744 18.0525 7.35519 17.9405 7.50496C17.8285 7.65472 17.6729 7.76609 17.495 7.82371Z" fill="currentColor"/></svg>`;

const impact = [
  { title: 'Product. Scalable without full redesign', icon: iconCategory },
  { title: 'Team. System survives designer changes', icon: iconProfile },
  { title: 'Process. Product grows without manual design control', icon: iconCursor },
];
---

<BaseLayout title={`${title} — Iryna Belkova`}>
  <Header />

  <main class="ap">
    <nav class="container ap-crumb" aria-label="Breadcrumb">
      <a href="/#work">Main</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Infrastructure UI solution for analytical platform</span>
    </nav>

    <!-- Hero -->
    <header class="container ap-hero">
      <div class="ap-hero__lead">
        <h1>{title}</h1>
        <p class="ap-hero__sub">{subtitle}</p>
      </div>
      <dl class="ap-meta">
        {meta.map((m) => (
          <div class="ap-meta__row">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- RTT design showcase -->
    <section class="container ap-figure ap-figure--lead">
      <div class="ap-figure__frame">
        <img src="/images/case-analytical/rtt.png" alt="Real-time trading terminal — the analytical platform's main working screen"
          width="1200" height="680" loading="lazy" decoding="async" />
        <span class="ap-badge ap-badge--corner">Example design RTT</span>
      </div>
    </section>

    <!-- Context and constraints -->
    <section class="container ap-section">
      <h2>Context and Product Constraints</h2>
      <div class="ap-cards">
        {contextCards.map((c) => (
          <article class="ap-card">
            <h3>{c.title}</h3>
            <ul>{c.bullets.map((b) => (
              <li>
                <span class="ap-card__dot" aria-hidden="true"></span>
                <span>{b}</span>
              </li>
            ))}</ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Problems — Figma "List bg" type: split content sits on a raised panel -->
    <section class="container ap-block">
      <div class="ap-split ap-panel">
        <h2>Problems of Managing Complex Data</h2>
        <div class="ap-list">
          {problems.map((p) => (
            <div class="ap-list__item">
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Design principles -->
    <section class="container ap-block">
      <div class="ap-split">
        <div class="ap-split__head">
          <h2>Design Principles</h2>
          <p class="ap-split__sub">System design for growth without losing control</p>
        </div>
        <div class="ap-list">
          {principles.map((p) => (
            <div class="ap-list__item">
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Before / after comparison -->
    <section class="container ap-figure">
      <div class="ap-compare" data-compare role="group" aria-label="Before and after comparison, draggable">
        <img class="ap-compare__after" src="/images/case-analytical/after.png" alt="After: the redesigned chart interface" draggable="false" loading="lazy" decoding="async" />
        <div class="ap-compare__before-wrap" data-compare-before-wrap>
          <img class="ap-compare__before" src="/images/case-analytical/before.png" alt="Before: the original chart interface" draggable="false" loading="lazy" decoding="async" />
        </div>
        <div class="ap-compare__handle" data-compare-handle>
          <span aria-hidden="true">◂▸</span>
        </div>
        <span class="ap-badge ap-badge--corner">Comparison of versions</span>
        <span class="ap-compare__label ap-compare__label--before">Before</span>
        <span class="ap-compare__label ap-compare__label--after">After</span>
      </div>
    </section>

    <!-- Adaptive chart system -->
    <section class="container ap-figure">
      <div class="ap-figure__lead">
        <h2 class="ap-figure__title">Adaptive Chart System</h2>
        <p class="ap-figure__desc">Panels and charts can be moved and combined freely. Typography contrast and grid system help users read data in any layout configuration.</p>
      </div>
      <div class="ap-figure__frame">
        <img src="/images/case-analytical/adaptive.png" alt="Adaptive chart system — panels rearranged into a different layout"
          width="1200" height="680" loading="lazy" decoding="async" />
        <span class="ap-badge ap-badge--corner">Example design FTT</span>
      </div>
    </section>

    <!-- Design system with a 4+ year horizon — title+list together on the
         left, visual alone on the right, so it gets its own grid rather
         than reusing .ap-split (which pairs a lone heading with a list). -->
    <section class="container ap-horizon">
      <div class="ap-horizon__left">
        <h2>Design System with 4+ Year Horizon</h2>
        <ol class="ap-horizon__list">
          {horizon.map((h) => (
            <li>
              <span class="ap-horizon__n">{h.n}</span>
              <p>{h.desc}</p>
            </li>
          ))}
        </ol>
      </div>
      <img class="ap-horizon__visual" src="/images/case-analytical/horizon-visual.png"
        alt="Design-system components: a chart and an input, each with its properties panel"
        width="590" height="520" loading="lazy" decoding="async" />
    </section>

    <!-- Product impact — Figma "List bg" type: split content on a raised panel,
         each item marked with a real icon (category/profile/cursor) in a halo,
         not a generic dot. -->
    <section class="container ap-block">
      <div class="ap-split ap-panel">
        <h2>Product Impact</h2>
        <ul class="ap-impact">
          {impact.map((i) => (
            <li>
              <span class="ap-impact__icon" aria-hidden="true" set:html={i.icon} />
              <span>{i.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Section rhythm — mobile-first; desktop pairs come from the token media query.
     Sections stack with zero gap between them; each section supplies its own
     vertical padding (matching the Figma frame, where every block is flush
     against the next and the visual rhythm comes entirely from each block's
     own py). */
  .ap {
    display: block;
  }
  .ap-block { padding-block: var(--space-section-y); }
  .ap h2 {
    font-size: var(--text-title-l);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
  }
  .ap h3 {
    font-size: var(--text-title-s);
    font-weight: var(--weight-semibold);
  }

  /* Breadcrumb */
  .ap-crumb {
    display: flex;
    gap: var(--space-3xs-static);
    align-items: center;
    padding-block: var(--space-sm-static);
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }
  .ap-crumb a:hover { opacity: var(--opacity-hover); }
  .ap-crumb [aria-current] {
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
  }

  /* Hero */
  .ap-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl-static);
    padding-block: var(--space-lg-static);
  }
  .ap-hero__lead { display: flex; flex-direction: column; gap: var(--space-sm-static); }
  .ap-hero h1 {
    font-size: var(--text-display-case);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
    letter-spacing: -0.01em;
  }
  .ap-hero__sub {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }
  .ap-meta { display: flex; flex-direction: column; gap: var(--space-md); margin: 0; }
  .ap-meta__row { display: grid; gap: var(--space-2xs-static); }
  .ap-meta__row + .ap-meta__row {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
  }
  .ap-meta dt { color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-meta dd {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }

  /* Full-bleed design figures */
  .ap-figure {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-section-y);
    padding-block: var(--space-section-y);
  }
  /* RTT — directly follows the hero, so it inherits the hero's larger
     bottom-of-block spacing on top instead of the standard section padding. */
  .ap-figure--lead { padding-top: var(--space-section-y-lg); }
  .ap-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }
  .ap-figure__lead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm-static);
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }
  .ap-figure__title { order: -1; }
  .ap-figure__desc {
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }
  .ap-figure__frame { position: relative; }

  /* Pill badge overlaid on design showcase images — matches the Figma
     "Example design" / "Comparison of versions" callouts. */
  .ap-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3xs-static) var(--space-xs-static);
    border-radius: var(--radius-control);
    background: var(--color-surface-scrim, rgba(60, 60, 60, 0.65));
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    color: var(--color-text-primary);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
  .ap-badge--corner {
    position: absolute;
    top: var(--space-xs-static);
    right: var(--space-xs-static);
  }

  /* Before / after comparison slider — same 1200×680 frame size as the other
     design showcases, with a visible outline (the only one of the three
     that has one in the Figma source). */
  .ap-compare {
    position: relative;
    width: 100%;
    aspect-ratio: 1200 / 680;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
    touch-action: pan-y;
  }
  .ap-compare__after,
  .ap-compare__before {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-drag: none;
    pointer-events: none;
  }
  .ap-compare__before-wrap {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
  }
  .ap-compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--color-surface-inverse);
    transform: translateX(-1px);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .ap-compare__handle span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    font-size: var(--text-label);
    letter-spacing: 0.05em;
  }
  .ap-compare__label {
    position: absolute;
    bottom: var(--space-xs-static);
    padding: var(--space-3xs-static) var(--space-xs-static);
    border-radius: var(--radius-control);
    background: var(--color-surface-scrim, rgba(60, 60, 60, 0.65));
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    color: var(--color-text-primary);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
  }
  .ap-compare__label--before { left: var(--space-xs-static); }
  .ap-compare__label--after { right: var(--space-xs-static); }

  /* Context cards */
  .ap-section { display: grid; grid-template-columns: 1fr; gap: var(--space-block-gap); padding-block: var(--space-section-y); }
  .ap-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-grid-gap);
  }
  .ap-card {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    padding: var(--space-card-inset);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg-static);
  }
  .ap-card h3 { font-size: var(--text-title-m); }
  .ap-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-sm-static);
  }
  .ap-card li {
    display: flex;
    align-items: flex-start;
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }
  .ap-card__dot {
    position: relative;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }
  .ap-card__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-dot);
    background: var(--color-accent);
    transform: translate(-50%, -50%);
  }

  /* Heading-left / list-right split sections */
  .ap-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md-static);
    align-items: start;
  }
  /* Problems/Impact's panel-bg variant uses a wider title↔list gap on mobile
     (24px) than Principles' plain split (20px) — both converge to 20px on
     desktop, handled in the desktop media query below. */
  .ap-split.ap-panel { gap: var(--space-lg-static); }
  .ap-split__sub {
    margin-top: var(--space-sm-static);
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }
  .ap-list { display: flex; flex-direction: column; gap: var(--space-md); }
  .ap-list__item { display: grid; grid-template-columns: 1fr; gap: var(--space-2xs-static); }
  .ap-list__item + .ap-list__item {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
  }
  .ap-list__item p { color: var(--color-text-muted); font-size: var(--text-body); max-width: 52ch; }
  /* Problems' list sits on the panel and uses a slightly wider title↔text
     gap (12px) than Principles' label/value rows (8px). */
  .ap-panel .ap-list__item { gap: var(--space-xs-static); }

  /* Design-system horizon — two equal columns on desktop (title+list, visual) */
  .ap-horizon {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-block-gap);
    padding-block: var(--space-section-y);
  }
  .ap-horizon__left {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg-static);
  }
  .ap-horizon__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-md); }
  .ap-horizon__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xs-static);
  }
  .ap-horizon__list li + li {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
  }
  .ap-horizon__n { color: var(--color-accent); font-weight: var(--weight-bold); font-size: var(--text-body); }
  .ap-horizon__list p { color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-horizon__visual {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    aspect-ratio: 590 / 520;
  }

  /* Panel background used by the "List bg" blocks (Problems, Product Impact) */
  .ap-panel {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: var(--space-lg-static);
  }

  /* Product impact — icon-in-halo marker, not a plain dot */
  .ap-impact { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-md); }
  .ap-impact li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm-static);
    align-items: center;
    font-size: var(--text-title-s);
    font-weight: var(--weight-semibold);
  }
  .ap-impact li + li {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border-subtle);
  }
  .ap-impact__icon {
    position: relative;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
  }
  .ap-impact__icon::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-control);
    background: var(--color-accent);
    opacity: 0.2;
  }
  .ap-impact__icon::after {
    content: '';
    position: absolute;
    inset: 16.6%;
    border-radius: var(--radius-control);
    background: var(--color-accent);
  }
  .ap-impact__icon :global(svg) {
    position: relative;
    z-index: 1;
    width: 18px;
    height: 18px;
    color: var(--color-text-primary);
  }

  /* ---- Desktop ---- */
  @media (min-width: 1024px) {
    .ap-hero {
      /* minmax(0, ...) so a long dd value or unbreakable word can't force a
         track wider than its fr share and push the grid past the viewport */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-md-static);
      padding-block: var(--space-section-y-lg);
    }
    .ap-hero__lead { gap: var(--space-lg-static); }
    .ap-cards { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
