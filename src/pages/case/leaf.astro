---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

// Ported from Figma "Web-portfolio" / page "Leaf" / frame Leaf-1920 (269:17542).
// This case has no clean "Type=Image" slot per section (each illustration is a
// custom-built pair of frames), so every illustration is exported as one
// combined image per section instead of following the shared Block/Image/Main
// pattern used by the other cases.
const title = 'Solo-built eco-habit mobile app';
const subtitle = 'Solo-designed end-to-end — from user research to Google Play, with 130+ original 3D illustrations';

const meta = [
  { label: 'Product', value: 'B2C Startup' },
  { label: 'Scale', value: 'Published on Google Play. Target audience: environmentally conscious users aged 18-35' },
  { label: 'Monetization Model', value: 'Free mobile app' },
  { label: 'Context', value: 'Full product cycle: UX research → UI design → 3D illustrations → launch' },
];

const processDesc =
  'This was a solo project from the first idea to the Google Play release. I independently completed every stage — from user research and app publishing to creating over 130 3D illustrations for marketing.';

const stages = [
  { title: 'Research', items: ['User surveys', 'User interviews', 'Competitor analysis', 'Mood board'] },
  { title: 'Prototyping', items: ['User flow', 'Wireframes'] },
  { title: 'UI Design', items: ['Visual concept', 'Design system', 'Illustrations'] },
  { title: 'Development', items: ['Building version 1.0'] },
  { title: 'Testing', items: ['User testing', 'Final improvements'] },
];

const iconCategory = `<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.24 0H3.34C1.15 0 0 1.15 0 3.33V5.23C0 7.41 1.15 8.56 3.33 8.56H5.23C7.41 8.56 8.56 7.41 8.56 5.23V3.33C8.57 1.15 7.42 0 5.24 0Z" fill="currentColor"/><path d="M16.67 0H14.77C12.59 0 11.44 1.15 11.44 3.33V5.23C11.44 7.41 12.59 8.56 14.77 8.56H16.67C18.85 8.56 20 7.41 20 5.23V3.33C20 1.15 18.85 0 16.67 0Z" fill="currentColor"/><path d="M16.67 11.43H14.77C12.59 11.43 11.44 12.58 11.44 14.76V16.66C11.44 18.84 12.59 19.99 14.77 19.99H16.67C18.85 19.99 20 18.84 20 16.66V14.76C20 12.58 18.85 11.43 16.67 11.43Z" fill="currentColor"/><path d="M5.24 11.43H3.34C1.15 11.43 0 12.58 0 14.76V16.66C0 18.85 1.15 20 3.33 20H5.23C7.41 20 8.56 18.85 8.56 16.67V14.77C8.57 12.58 7.42 11.43 5.24 11.43Z" fill="currentColor"/></svg>`;
const iconProfile = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C9.38 2 7.25 4.13 7.25 6.75C7.25 9.32 9.26 11.4 11.88 11.49C11.96 11.48 12.04 11.48 12.1 11.49C12.12 11.49 12.13 11.49 12.15 11.49C12.16 11.49 12.16 11.49 12.17 11.49C14.73 11.4 16.74 9.32 16.75 6.75C16.75 4.13 14.62 2 12 2Z" fill="currentColor"/><path d="M17.08 14.15C14.29 12.29 9.73996 12.29 6.92996 14.15C5.65996 15 4.95996 16.15 4.95996 17.38C4.95996 18.61 5.65996 19.75 6.91996 20.59C8.31996 21.53 10.16 22 12 22C13.84 22 15.68 21.53 17.08 20.59C18.34 19.74 19.04 18.6 19.04 17.36C19.03 16.13 18.34 14.99 17.08 14.15Z" fill="currentColor"/></svg>`;
const iconGallery = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 10.38C10.3144 10.38 11.38 9.31444 11.38 8C11.38 6.68556 10.3144 5.62 9 5.62C7.68556 5.62 6.62 6.68556 6.62 8C6.62 9.31444 7.68556 10.38 9 10.38Z" fill="currentColor"/><path d="M16.19 2H7.81C4.17 2 2 4.17 2 7.81V16.19C2 17.28 2.19 18.23 2.56 19.03C3.42 20.93 5.26 22 7.81 22H16.19C19.83 22 22 19.83 22 16.19V7.81C22 4.17 19.83 2 16.19 2ZM20.37 12.5C19.59 11.83 18.33 11.83 17.55 12.5L13.39 16.07C12.61 16.74 11.35 16.74 10.57 16.07L10.23 15.79C9.52 15.17 8.39 15.11 7.59 15.65L3.85 18.16C3.63 17.6 3.5 16.95 3.5 16.19V7.81C3.5 4.99 4.99 3.5 7.81 3.5H16.19C19.01 3.5 20.5 4.99 20.5 7.81V12.61L20.37 12.5Z" fill="currentColor"/></svg>`;

const results = [
  { title: "74% of users didn't know where to start, shaping the onboarding and beginner's guide", icon: iconProfile },
  { title: 'Built the product end-to-end - from wireframes to Google Play release', icon: iconCategory },
  { title: 'Created 130+ 3D illustrations in Cinema 4D', icon: iconGallery },
];
---

<BaseLayout title={`${title} — Iryna Belkova`}>
  <Header />

  <main class="ap">
    <div class="container ap-crumb">
      <Breadcrumbs parentLabel="Main" parentHref="/#work" current={title} />
    </div>

    <!-- Hero -->
    <header class="container ap-hero">
      <div class="ap-hero__lead">
        <h1>{title}</h1>
        <p class="ap-hero__sub">{subtitle}</p>
      </div>
      <dl class="ap-meta">
        {meta.map((m) => (
          <div class="ap-meta__row">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- Main product showcase -->
    <section class="container ap-figure ap-figure--lead">
      <div class="ap-figure__frame">
        <img src="/images/case-leaf/hero-full.png" alt="Leaf app screens — product view, schedule, and recycling point details"
          width="2400" height="1360" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Development Process — Figma wraps this in a dark card with the title
         and description side by side, a segmented progress bar above the
         5-column step list, not a bare heading + stacked description. -->
    <section class="container ap-block">
      <div class="ap-process-card">
        <div class="ap-process-card__head">
          <h2>Development Process</h2>
          <p class="ap-process-card__desc">{processDesc}</p>
        </div>
        <div class="ap-progress">
          <div class="ap-progress__bar">
            {stages.map(() => <span class="ap-progress__segment" />)}
          </div>
          <div class="ap-stages">
            {stages.map((s) => (
              <div class="ap-stages__col">
                <h3>{s.title}</h3>
                <ul>{s.items.map((item) => <li>{item}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Research -->
    <section class="container ap-figure">
      <div class="ap-figure__lead">
        <h2 class="ap-figure__title">Research</h2>
        <p class="ap-figure__desc">User behavior and waste management habits were explored through in-depth research. Understanding users' needs and motivations became the foundation for creating a user-centered solution.</p>
      </div>
      <div class="ap-figure__frame">
        <img src="/images/case-leaf/research.png" alt="User research findings — survey results and interview insights"
          width="1200" height="1220" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Prototyping -->
    <section class="container ap-figure">
      <div class="ap-figure__lead">
        <h2 class="ap-figure__title">Prototyping</h2>
        <p class="ap-figure__desc">Based on the insights gathered during the research phase, I designed prototypes to evaluate the usability and effectiveness of the application.</p>
      </div>
      <div class="ap-figure__frame">
        <img src="/images/case-leaf/prototyping.png" alt="Low-fidelity prototypes for the recycling planner and onboarding flow"
          width="1200" height="1240" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- UI Design — Figma has the title+description living inside the same
         gradient panel as the phone mockups, not stacked above a bare image. -->
    <section class="container ap-block">
      <div class="ap-figure-overlay">
        <img src="/images/case-leaf/ui-design.png" alt="Final UI — material catalog and recycling point map screens"
          width="1240" height="580" loading="lazy" decoding="async" />
        <div class="ap-figure-overlay__text">
          <h2>UI Design</h2>
          <p>A minimalist interface focused on quick access to key features: a recycling point map, a material catalog with 3D illustrations, and a beginner's guide. The onboarding experience was designed based on real user questions identified during the research phase.</p>
        </div>
      </div>
    </section>

    <!-- Illustrations -->
    <section class="container ap-figure">
      <div class="ap-figure__lead">
        <h2 class="ap-figure__title">Illustrations</h2>
        <p class="ap-figure__desc">All illustrations were created in Cinema 4D, with over 130 unique 3D assets designed for different material types and recycling scenarios. The distinctive 3D visual style helps LEAF stand out from typical flat-design eco apps.</p>
      </div>
      <div class="ap-figure__frame">
        <img src="/images/case-leaf/illustrations.png" alt="3D illustrations created in Cinema 4D for material types and recycling scenarios"
          width="1200" height="610" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Results -->
    <section class="container ap-block">
      <div class="ap-split">
        <h2>Results</h2>
        <ul class="ap-impact">
          {results.map((r) => (
            <li>
              <span class="ap-impact__icon" aria-hidden="true" set:html={r.icon} />
              <span>{r.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ap { display: block; }
  .ap-block { padding-block: var(--space-section-y); }
  .ap h2 { font-size: var(--text-title-l); font-weight: var(--weight-semibold); line-height: var(--leading-heading); }
  .ap h3 { font-size: var(--text-title-s); font-weight: var(--weight-semibold); }

  .ap-crumb { padding-block: var(--space-sm-static); }

  .ap-hero {
    display: grid; grid-template-columns: 1fr; gap: var(--space-xl-static); padding-block: var(--space-lg-static);
  }
  .ap-hero__lead { display: flex; flex-direction: column; gap: var(--space-sm-static); }
  .ap-hero h1 { font-size: var(--text-display-case); font-weight: var(--weight-semibold); line-height: var(--leading-heading); letter-spacing: -0.01em; }
  .ap-hero__sub { color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-meta { display: flex; flex-direction: column; gap: var(--space-md); margin: 0; }
  .ap-meta__row { display: grid; gap: var(--space-2xs-static); }
  .ap-meta__row + .ap-meta__row { padding-top: var(--space-md); border-top: 1px solid var(--color-border-subtle); }
  .ap-meta dt { color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-meta dd { margin: 0; color: var(--color-text-primary); font-size: var(--text-body); font-weight: var(--weight-semibold); }

  .ap-figure { display: grid; grid-template-columns: 1fr; gap: var(--space-section-y); padding-block: var(--space-section-y); }
  .ap-figure--lead { padding-top: var(--space-section-y-lg); }
  .ap-figure img { width: 100%; height: auto; border-radius: var(--radius-card); }
  /* Figma sits the section title and its description side by side (a
     "Title and Description" row), not centered and stacked — the centered
     treatment made the description read as sitting under the title instead
     of beside it. */
  .ap-figure__lead { display: flex; flex-direction: column; gap: var(--space-sm-static); }
  .ap-figure__desc { margin: 0; color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-figure__frame { position: relative; }

  /* UI Design — title+description live inside the same gradient panel as the
     phone mockups (mobile: stacked plainly above the image; desktop: overlaid
     on the left, matching the Figma layout). */
  .ap-figure-overlay { display: flex; flex-direction: column; gap: var(--space-sm-static); }
  .ap-figure-overlay img { width: 100%; height: auto; border-radius: var(--radius-card); }
  .ap-figure-overlay__text h2 { order: -1; }
  .ap-figure-overlay__text p { margin: 0; color: var(--color-text-muted); font-size: var(--text-body); }

  .ap-split { display: grid; grid-template-columns: 1fr; gap: var(--space-md-static); align-items: start; }
  .ap-impact { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-md); }
  .ap-impact li {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm-static); align-items: start;
    font-size: var(--text-title-s); font-weight: var(--weight-semibold);
  }
  .ap-impact li + li { padding-top: var(--space-md); border-top: 1px solid var(--color-border-subtle); }
  .ap-impact__icon { position: relative; width: 48px; height: 48px; display: grid; place-items: center; }
  .ap-impact__icon::before { content: ''; position: absolute; inset: 0; border-radius: var(--radius-control); background: var(--color-accent); opacity: 0.2; }
  .ap-impact__icon::after { content: ''; position: absolute; inset: 16.6%; border-radius: var(--radius-control); background: var(--color-accent); }
  .ap-impact__icon :global(svg) { position: relative; z-index: 1; width: 18px; height: 18px; color: var(--color-text-primary); }

  /* Development Process card — dark surface wrapping the title/description
     row and the progress bar + steps. 64px padding and the card's own
     48px internal gap are fixed values straight from Figma, not part of
     the shared spacing ladder. */
  .ap-process-card {
    background: var(--color-surface-quote); border-radius: var(--radius-24);
    padding: var(--space-lg-static); display: grid; gap: var(--space-lg-static);
  }
  .ap-process-card__head { display: flex; flex-direction: column; gap: var(--space-sm-static); }
  .ap-process-card__desc { margin: 0; color: var(--color-text-muted); font-size: var(--text-body); line-height: var(--leading-component); }
  .ap-progress { display: grid; gap: var(--space-xl-static); }
  .ap-progress__bar { display: flex; gap: 10px; }
  .ap-progress__segment { flex: 1; height: 20px; border-radius: var(--radius-pill); background: var(--color-accent); }
  /* Figma fades the bar from the earliest stage (dimmest) to the current one
     (full opacity), all on the same accent fill — not five solid blocks. */
  .ap-progress__segment:nth-child(1) { opacity: 0.4; }
  .ap-progress__segment:nth-child(2) { opacity: 0.5; }
  .ap-progress__segment:nth-child(3) { opacity: 0.8; }
  .ap-progress__segment:nth-child(4) { opacity: 0.9; }
  .ap-progress__segment:nth-child(5) { opacity: 0.9; }
  .ap-stages { display: grid; grid-template-columns: 1fr; gap: var(--space-lg-static); }
  .ap-stages__col { display: grid; gap: var(--space-lg-static); }
  .ap-stages__col h3 { font-size: 16px; font-weight: var(--weight-semibold); line-height: var(--leading-component); }
  .ap-stages__col ul { margin: 0; padding-left: 14px; list-style: disc; display: grid; gap: var(--space-2xs-static); }
  .ap-stages__col li { color: var(--color-text-muted); font-size: var(--text-label); line-height: var(--leading-component); }
  .ap-stages__col li::marker { color: var(--color-text-muted); }

  @media (min-width: 1024px) {
    .ap-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start;
      gap: var(--space-md-static); padding-block: var(--space-section-y-lg);
    }
    .ap-hero__lead { gap: var(--space-lg-static); }
    .ap-figure__lead { flex-direction: row; align-items: flex-start; gap: var(--space-md-static); }
    .ap-figure__title, .ap-figure__desc { flex: 1 0 0; min-width: 0; }
    .ap-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-md-static); }
    .ap-process-card { padding: 64px; gap: var(--size-48); }
    .ap-process-card__head { flex-direction: row; align-items: flex-start; gap: var(--space-md-static); }
    .ap-process-card__head h2, .ap-process-card__desc { flex: 1 0 0; min-width: 0; }
    .ap-stages { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-xs-static); }
    .ap-figure-overlay { position: relative; }
    .ap-figure-overlay__text {
      position: absolute;
      top: 50%;
      left: var(--space-panel-inset);
      transform: translateY(-50%);
      max-width: 42%;
      display: flex;
      flex-direction: column;
      gap: var(--space-sm-static);
    }
    .ap-impact__icon { width: 64px; height: 64px; }
    .ap-impact__icon :global(svg) { width: 24px; height: 24px; }
  }
</style>
