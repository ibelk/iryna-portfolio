  cube: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 22.75C14.73 22.75 14.48 22.6 14.35 22.37C14.22 22.14 14.22 21.85 14.36 21.62L15.41 19.87C15.62 19.51 16.08 19.4 16.44 19.61C16.8 19.82 16.91 20.28 16.7 20.64L16.43 21.09C19.19 20.44 21.26 17.96 21.26 15C21.26 14.59 21.6 14.25 22.01 14.25C22.42 14.25 22.76 14.59 22.76 15C22.75 19.27 19.27 22.75 15 22.75Z" fill="currentColor"/><path d="M2 9.75C1.59 9.75 1.25 9.41 1.25 9C1.25 4.73 4.73 1.25 9 1.25C9.27 1.25 9.52 1.4 9.65 1.63C9.78 1.86 9.78 2.15 9.64 2.38L8.59 4.14C8.38 4.49 7.92 4.61 7.56 4.39C7.21 4.18 7.09 3.72 7.31 3.36L7.58 2.91C4.81 3.56 2.75 6.04 2.75 9C2.75 9.41 2.41 9.75 2 9.75Z" fill="currentColor"/><path d="M10.67 13.85L7.53 12.16C7.2 11.98 6.8 11.98 6.47 12.16L3.33 13.85C3.1 13.97 2.96 14.22 2.96 14.49C2.96 14.76 3.1 15.01 3.33 15.13L6.47 16.82C6.64 16.91 6.82 16.95 7 16.95C7.18 16.95 7.36 16.91 7.53 16.82L10.67 15.13C10.9 15.01 11.04 14.76 11.04 14.49C11.04 14.22 10.89 13.98 10.67 13.85Z" fill="currentColor"/><path d="M5.95 17.41L3.03 15.95C2.81 15.84 2.55 15.85 2.33 15.98C2.13 16.11 2 16.34 2 16.59V19.35C2 19.83 2.26 20.26 2.69 20.47L5.61 21.93C5.71 21.97 5.82 22 5.93 22C6.06 22 6.19 21.96 6.31 21.89C6.52 21.76 6.65 21.53 6.65 21.28V18.52C6.65 18.05 6.38 17.62 5.95 17.41Z" fill="currentColor"/><path d="M11.66 15.98C11.45 15.85 11.19 15.84 10.96 15.95L8.04 17.41C7.61 17.62 7.35 18.05 7.35 18.53V21.29C7.35 21.54 7.48 21.77 7.69 21.9C7.81 21.96 7.94 22 8.07 22C8.18 22 8.29 21.97 8.39 21.92L11.31 20.46C11.74 20.25 12 19.82 12 19.34V16.58C12 16.34 11.87 16.11 11.66 15.98Z" fill="currentColor"/><path d="M20.67 3.83L17.53 2.14C17.2 1.96 16.8 1.96 16.47 2.14L13.33 3.83C13.1 3.95 12.96 4.2 12.96 4.47C12.96 4.74 13.1 4.99 13.33 5.11L16.47 6.8C16.64 6.89 16.82 6.93 17 6.93C17.18 6.93 17.36 6.89 17.53 6.8L20.67 5.11C20.9 4.99 21.04 4.74 21.04 4.47C21.04 4.19 20.89 3.95 20.67 3.83Z" fill="currentColor"/><path d="M15.95 7.38L13.03 5.92C12.81 5.81 12.55 5.82 12.33 5.95C12.13 6.