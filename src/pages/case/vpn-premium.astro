---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Ported from Figma "Web-portfolio" / page "Premium" / frame Premium-1920 (269:16414).
const title = 'Premium purchase flow redesign';
const subtitle = 'Increased conversion to payment through changes in the purchase flow';

const meta = [
  { label: 'Product', value: 'B2C product' },
  { label: 'Scale', value: '700,000+ website visitors per month' },
  { label: 'Monetization model', value: 'Freemium → Premium' },
  { label: 'Restrictions', value: 'Impossibility of complete redesign and change of pricing policy' },
];

const constraintCards = [
  { title: '700,000+ users per month', desc: 'Any change scales immediately', icon: 'profile' },
  { title: 'Iterative approach', desc: 'No full redesign. No stop in development', icon: 'cursor' },
  { title: 'Fixed monetization model', desc: 'No changes in pricing or plans', icon: 'setting' },
  { title: 'Transparent checkout', desc: 'Full order summary, discounts and savings', icon: 'eye' },
];

const problems = [
  { title: 'Premium has no clear value explanation. Users delay the decision.' },
  { title: 'Focus on free, not monetization' },
  { title: 'Microsoft Clarity heat maps showed that the Premium button was losing priority to links to internal pages.' },
];

const changeCards = [
  { title: 'Separation of selection and payment', desc: 'Pricing page and payment page became two steps. User focuses on one decision at a time.' },
  { title: 'Shift of focus  to Premium', desc: 'Primary buttons now lead to purchase. Free option is still available but no longer dominant.' },
  { title: 'Value instead  of illustrations', desc: 'Removed decorative blocks. Added clear list of Premium features. User sees what they pay for.' },
  { title: 'Subscription period repositioning', desc: 'Plan selection moved to the top. Communication starts from the lowest monthly price.' },
  { title: 'Transparency at checkout', desc: 'User sees full order details, discounts and savings.' },
  { title: 'Promo code support', desc: 'Added clear entry point for promo code. No interface overload.' },
];

const icons: Record<string, string> = {
