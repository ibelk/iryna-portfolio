  danger: `<svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 0C4.49 0 0 4.49 0 10C0 15.51 4.49 20 10 20C15.51 20 20 15.51 20 10C20 4.49 15.52 0 10 0ZM9.25 6.5C9.25 6.09 9.59 5.75 10 5.75C10.41 5.75 10.75 6.09 10.75 6.5V11C10.75 11.41 10.41 11.75 10 11.75C9.59 11.75 9.25 11.41 9.25 11V6.5ZM10.92 14.33C10.87 14.46 10.8 14.56 10.71 14.66C10.61 14.75 10.5 14.82 10.38 14.87C10.26 14.92 10.13 14.95 10 14.95C9.87 14.95 9.74 14.92 9.62 14.87C9.5 14.82 9.39 14.75 9.29 14.66C9.2 14.56 9.13 14.46 9.08 14.33C9.03 14.21 9 14.08 9 13.95C9 13.82 9.03 13.69 9.08 13.57C9.13 13.45 9.2 13.34 9.29 13.24C9.39 13.15 9.5 13.08 9.62 13.03C9.86 12.93 10.14 12.93 10.38 13.03C10.5 13.08 10.61 13.15 10.71 13.24C10.8 13.34 10.87 13.45 10.92 13.57C10.97 13.69 11 13.82 11 13.95C11 14.08 10.97 14.21 10.92 14.33Z" fill="currentColor"/></svg>`,
};

const impact = [
  { title: 'Shift in user focus from "Download" to "Buy Premium"', icon: 'eye' },
  { title: 'Ready for A/B testing', icon: 'cube' },
  { title: 'Conversion increased from 0.28% to 0.34%', icon: 'chart' },
];
---

<BaseLayout title={`${title} — Iryna Belkova`}>
  <Header />

  <main class="ap">
    <nav class="container ap-crumb" aria-label="Breadcrumb">
      <a href="/#work">Main</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <!-- Hero -->
    <header class="container ap-hero">
      <div class="ap-hero__lead">
        <h1>{title}</h1>
        <p class="ap-hero__sub">{subtitle}</p>
        <p class="ap-nda">
          <span aria-hidden="true" set:html={icons.danger} />
          Interfaces reproduced for portfolio via NDA
        </p>
      </div>
      <dl class="ap-meta">
        {meta.map((m) => (
          <div class="ap-meta__row">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- Main product showcase -->
    <section class="container ap-figure ap-figure--lead">
      <div class="ap-figure__frame">
        <img src="/images/case-vpn-premium/web.png" alt="VPN web purchase flow — pricing and checkout screens"
          width="1200" height="680" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Constraints and Context -->
    <section class="container ap-section">
      <h2>Constraints and Context</h2>
      <div class="ap-criteria ap-criteria--2col">
        {constraintCards.map((c) => (
          <article class="ap-criteria__card">
            <span class="ap-criteria__icon" aria-hidden="true" set:html={icons[c.icon]} />
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Why users don't reach payment -->
    <section class="container ap-block">
      <div class="ap-split">
        <div class="ap-split__head">
          <h2>Why Users don't <br />Reach Payment</h2>
        </div>
        <ol class="ap-horizon__list">
          {problems.map((p, i) => (
            <li>
              <span class="ap-horizon__n">{String(i + 1).padStart(2, '0')}</span>
              <p>{p.title}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="ap-figure__frame ap-split__visual">
        <img src="/images/case-vpn-premium/mobile.png" alt="Heatmap showing users clicking away from the Premium button"
          width="590" height="520" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Rebuilding the decision architecture -->
    <section class="container ap-figure">
      <div class="ap-figure__lead">
        <h2 class="ap-figure__title">Rebuilding the Decision Architecture</h2>
        <p class="ap-figure__desc">We rebuilt the upgrade logic. Before: one screen with many elements. After: structured decision flow. The goal was to guide the user step by step to a clear purchase decision.</p>
      </div>
      <div class="ap-figure__frame">
        <img src="/images/case-vpn-premium/plan.png" alt="New pricing plan selection screen"
          width="1000" height="440" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Key changes in the purchase flow -->
    <section class="container ap-section">
      <h2>Key Changes in the Purchase Flow</h2>
      <div class="ap-criteria ap-criteria--3col ap-criteria--text-only">
        {changeCards.map((c) => (
          <article class="ap-criteria__card">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Product impact -->
    <section class="container ap-block">
      <div class="ap-split ap-panel">
        <h2>Product Impact</h2>
        <ul class="ap-impact">
          {impact.map((i) => (
            <li>
              <span class="ap-impact__icon" aria-hidden="true" set:html={icons[i.icon]} />
              <span>{i.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ap { display: block; }
  .ap-block { padding-block: var(--space-section-y); }
  .ap h2 { font-size: var(--text-title-l); font-weight: var(--weight-semibold); line-height: 1.15; }
  .ap h3 { font-size: var(--text-title-s); font-weight: var(--weight-semibold); }

  .ap-crumb {
    display: flex; gap: var(--space-3xs-static); align-items: center;
    padding-block: var(--space-sm-static); color: var(--color-text-muted); font-size: var(--text-body);
  }
  .ap-crumb a:hover { opacity: var(--opacity-hover); }
  .ap-crumb [aria-current] { color: var(--color-text-primary); font-weight: var(--weight-semibold); }

  .ap-hero {
    display: grid; grid-template-columns: 1fr; gap: var(--space-xl-static); padding-block: var(--space-lg-static);
  }
  .ap-hero__lead { display: flex; flex-direction: column; gap: var(--space-sm-static); }
  .ap-hero h1 { font-size: var(--text-display-case); font-weight: var(--weight-semibold); line-height: 1.05; letter-spacing: -0.01em; }
  .ap-hero__sub { max-width: 34ch; color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-nda {
    display: flex; align-items: center; gap: var(--space-2xs-static); margin-top: var(--space-sm-static);
    padding: var(--space-sm-static); border-radius: var(--radius-banner); background: rgba(255, 128, 0, 0.27);
    color: white; font-size: var(--text-label); font-weight: var(--weight-medium, 500);
  }
  .ap-nda :global(svg) { width: 20px; height: 20px; flex-shrink: 0; }
  .ap-meta { display: flex; flex-direction: column; gap: var(--space-md); margin: 0; }
  .ap-meta__row { display: grid; gap: var(--space-2xs-static); }
  .ap-meta__row + .ap-meta__row { padding-top: var(--space-md); border-top: 1px solid var(--color-border-subtle); }
  .ap-meta dt { color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-meta dd { margin: 0; color: var(--color-text-primary); font-size: var(--text-body); font-weight: var(--weight-semibold); }

  .ap-figure { display: grid; grid-template-columns: 1fr; gap: var(--space-section-y); padding-block: var(--space-section-y); }
  .ap-figure--lead { padding-top: var(--space-section-y-lg); }
  .ap-figure img { width: 100%; height: auto; border-radius: var(--radius-card); }
  .ap-figure__lead {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-sm-static);
    text-align: center; max-width: 60ch; margin-inline: auto;
  }
  .ap-figure__title { order: -1; }
  .ap-figure__desc { color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-figure__frame { position: relative; }

  .ap-split { display: grid; grid-template-columns: 1fr; gap: var(--space-md-static); align-items: start; }
  .ap-split__visual { margin-top: var(--space-md-static); }

  .ap-horizon__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-md); }
  .ap-horizon__list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm-static); }
  .ap-horizon__list li + li { padding-top: var(--space-md); border-top: 1px solid var(--color-border-subtle); }
  .ap-horizon__n { color: var(--color-accent); font-weight: var(--weight-bold); font-size: var(--text-body); }
  .ap-horizon__list p { color: var(--color-text-muted); font-size: var(--text-body); }

  .ap-panel { background: var(--color-surface); border-radius: var(--radius-card); padding: var(--space-lg-static); }
  .ap-impact { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-md); }
  .ap-impact li {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm-static); align-items: center;
    font-size: var(--text-title-s); font-weight: var(--weight-semibold);
  }
  .ap-impact li + li { padding-top: var(--space-md); border-top: 1px solid var(--color-border-subtle); }
  .ap-impact__icon { position: relative; width: 48px; height: 48px; display: grid; place-items: center; }
  .ap-impact__icon::before { content: ''; position: absolute; inset: 0; border-radius: var(--radius-control); background: var(--color-accent); opacity: 0.2; }
  .ap-impact__icon::after { content: ''; position: absolute; inset: 16.6%; border-radius: var(--radius-control); background: var(--color-accent); }
  .ap-impact__icon :global(svg) { position: relative; z-index: 1; width: 18px; height: 18px; color: var(--color-text-primary); }

  .ap-section { display: grid; grid-template-columns: 1fr; gap: var(--space-block-gap); padding-block: var(--space-section-y); }
  .ap-criteria { display: grid; grid-template-columns: 1fr; gap: var(--space-md-static); }
  .ap-criteria__card {
    border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: var(--space-card-inset-lg);
    display: grid; gap: var(--space-lg-static);
  }
  .ap-criteria__icon { position: relative; width: 48px; height: 48px; display: grid; place-items: center; }
  .ap-criteria__icon::before { content: ''; position: absolute; inset: 0; border-radius: var(--radius-control); background: var(--color-accent); opacity: 0.2; }
  .ap-criteria__icon::after { content: ''; position: absolute; inset: 16.6%; border-radius: var(--radius-control); background: var(--color-accent); }
  .ap-criteria__icon :global(svg) { position: relative; z-index: 1; width: 24px; height: 24px; color: var(--color-text-primary); }
  .ap-criteria__card p { margin: 0; color: var(--color-text-muted); font-size: var(--text-body); }
  .ap-criteria--text-only .ap-criteria__card { gap: var(--space-sm-static); }

  @media (min-width: 1024px) {
    .ap-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start;
      gap: var(--space-md-static); padding-block: var(--space-section-y-lg);
    }
    .ap-hero__lead { gap: var(--space-lg-static); }
    .ap-figure__lead { gap: var(--space-lg-static); }
    .ap-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-md-static); }
    .ap-split__visual { margin-top: 0; }
    .ap-section { gap: var(--space-card-inset-lg); }
    .ap-criteria--2col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ap-criteria--3col { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ap-criteria__card { padding: var(--space-card-inset-lg); }
