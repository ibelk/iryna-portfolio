---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

// Ported from Figma "Web-portfolio" / page "VPN" / frame VPN-1920 (260:13642).
// The three app-mockup illustrations (main hero, desktop app, error/contrast
// panels) are exported design frames served as images — same pattern as the
// Analytical Platform case.
const title = 'Typography and accessibility in VPN';
const subtitle = 'Unified typography across 60+ languages — fix requests dropped from weekly to monthly';

const meta = [
  { label: 'Product', value: 'VPN apps (desktop, mobile, browser extension)' },
  { label: 'Scale', value: 'Over 10 million users' },
  { label: 'Localization', value: '60+ languages' },
  { label: 'Environment', value: 'A living product without pause for redesign' },
];

const problems = [
  { title: 'Montserrat was used as a system font without considering localization' },
  { title: 'Low contrast of key UI elements' },
  { title: 'Text did not meet WCAG standards' },
];

const quoteRows = [
  {
    role: 'Translators',
    icon: 'smallcaps',
    wrong: "Phrases didn't fit UI components and often lost meaning",
    effect: 'Incorrect or broken translations in the UI',
    quote: "German translations don't fit the button again — half the word gets cut off.",
  },
  {
    role: 'Developers',
    icon: 'setting',
    wrong: 'Each new language caused layout issues or broken elements',
    effect: 'Constant fixes slowed down release cycles',
    quote: 'Every new language feels like a whole new project.',
  },
  {
    role: 'QA Testers',
    icon: 'danger',
    wrong: 'Every new locale introduced new bugs during testing',
    effect: 'Manual re-checking of all localization scenarios each time',
    quote: 'Something always breaks — guaranteed.',
  },
];

const criteria = [
  { title: 'Localization', desc: 'Full language support (Latin, Cyrillic, CJK, RTL)', icon: 'smallcaps' },
  { title: 'Scale', desc: 'Stable rendering across operating systems', icon: 'maximize' },
  { title: 'Accessibility', desc: 'Good readability for small text', icon: 'eye' },
  { title: 'Licensing', desc: 'License suitable for commercial product', icon: 'document' },
];

const notoReasons = [
  { title: 'Only font with full language coverage' },
  { title: 'Consistent behavior across platforms' },
  { title: 'Suitable for system-level use' },
  { title: 'OFL license' },
];

const contrastDesc =
  'Low contrast makes information harder to read. It increases cognitive load. It directly affects product usability. WCAG compliance is a minimum standard for a product with millions of users.';

const iconEye = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21.25 9.14999C18.94 5.51999 15.56 3.42999 12 3.42999C10.22 3.42999 8.49 3.94999 6.91 4.91999C5.33 5.89999 3.91 7.32999 2.75 9.14999C1.75 10.72 1.75 13.27 2.75 14.84C5.06 18.48 8.44 20.56 12 20.56C13.78 20.56 15.51 20.04 17.09 19.07C18.67 18.09 20.09 16.66 21.25 14.84C22.25 13.28 22.25 10.72 21.25 9.14999ZM12 16.04C9.76 16.04 7.96 14.23 7.96 12C7.96 9.76999 9.76 7.95999 12 7.95999C14.24 7.95999 16.04 9.76999 16.04 12C16.04 14.23 14.24 16.04 12 16.04Z" fill="currentColor"/><path d="M11.9999 9.14001C10.4299 9.14001 9.1499 10.42 9.1499 12C9.1499 13.57 10.4299 14.85 11.9999 14.85C13.5699 14.85 14.8599 13.57 14.8599 12C14.8599 10.43 13.5699 9.14001 11.9999 9.14001Z" fill="currentColor"/></svg>`;
