---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WritingCard from '../../components/WritingCard.astro';

const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Writing — Iryna Belkova">
  <Header />

  <main>
    <div class="container page-crumb">
      <Breadcrumbs parentLabel="Main" parentHref="/" current="Writing" />
    </div>

    <section class="container page-head">
      <h1 class="page-head__title">Writing</h1>
      <p class="page-head__intro">
        Notes on testing new tools and on troubleshooting design problems inside live products.
      </p>
    </section>

    <section class="container grid">
      {
        posts.map((post) => (
          <WritingCard
            title={post.data.title}
            image={post.data.image}
            href={post.data.linkedinUrl}
            tags={post.data.tags}
          />
        ))
      }
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* 24px under the title, matching the design: cap-height trimming removes the
     font's own leading, so a smaller gap reads as collapsed. */
  .page-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg-static);
    padding-block: var(--space-section-y);
  }

  .page-head__title {
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
  }

  .page-crumb {
    padding-block: var(--space-sm-static);
  }

  .page-head__intro {
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-grid-gap);
    padding-block: var(--space-section-y);
  }

  /* Figma has both this section and the hero above it padding by a fixed
     36px, not the standard 48px section rhythm — using --space-section-y
     here stacked 48+48px of gap between the intro and the card grid where
     Figma has 36+36px. */
  @media (min-width: 1024px) {
    .page-head {
      padding-block: 36px;
    }

    .grid {
      padding-block: 36px 48px;
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
