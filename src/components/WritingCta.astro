---
interface Props {
  title: string;
  body: string;
  linkLabel: string;
  href: string;
}
const { title, body, linkLabel, href } = Astro.props;
---

<a class="writing-cta" href={href}>
  <div class="writing-cta__text">
    <h3 class="writing-cta__title">{title}</h3>
    <p class="writing-cta__body">{body}</p>
  </div>
  <span class="writing-cta__link">
    {linkLabel}
    <svg class="writing-cta__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M13.43 5.93 19.5 12l-6.07 6.07M4.5 12H19.33" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .writing-cta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-lg-static);
    background: var(--color-surface-inverse);
    border-radius: var(--radius-card);
    color: var(--color-text-inverse);
    text-decoration: none;
    transition: transform var(--motion-normal) var(--motion-ease);
  }

  @media (min-width: 1024px) {
    .writing-cta { padding: var(--size-32); }
  }

  .writing-cta:hover {
    transform: translateY(-4px);
  }

  .writing-cta__text {
    display: flex;
    flex-direction: column;
    gap: var(--size-16);
  }

  .writing-cta__title {
    font-size: var(--text-title-m);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
  }

  .writing-cta__body {
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    color: var(--color-text-inverse-secondary);
  }

  .writing-cta__link {
    display: flex;
    align-items: center;
    gap: var(--size-8);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
  }

  .writing-cta__icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
</style>
