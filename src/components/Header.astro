---
const navLinks = [
  { label: 'Work', href: '/#work' },
  { label: 'Experiments', href: '/#experiments' },
  { label: 'Writing', href: '/#writing' },
  { label: 'Download CV', href: '/Belkova_Iryna_CV_EN.pdf' },
];
---

<header class="site-header">
  <div class="container">
    <div class="site-header__pill">
      <div class="site-header__row">
        <a class="site-header__brand" href="/">
          <img class="site-header__logo" src="/images/logo.svg" alt="" width="36" height="36" />
          <span class="site-header__name">Belkova Iryna</span>
        </a>

        <button
          class="site-header__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <span class="site-header__burger" aria-hidden="true"></span>
        </button>
      </div>

      <nav class="site-header__nav" id="site-nav" aria-label="Main">
        {
          navLinks.map((link) => (
            <a class="site-header__link" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__contact-wrap">
        <a class="site-header__contact" href="mailto:iryn.belkova@gmail.com" id="contact-trigger">Contact me</a>
        <div class="contact-popover" id="contact-popover" hidden>
          <span class="contact-popover__caret" aria-hidden="true"></span>
          <div class="contact-popover__head">
            <span class="contact-popover__label">Email</span>
            <button class="contact-popover__close" type="button" aria-label="Close">×</button>
          </div>
          <div class="contact-popover__row">
            <input class="contact-popover__input" type="text" value="iryn.belkova@gmail.com" readonly />
            <button class="contact-popover__copy" type="button">Copy</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const pill = document.querySelector<HTMLElement>('.site-header__pill');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    pill?.classList.toggle('site-header__pill--open', !open);
  });

  const updateScrolled = () => {
    pill?.classList.toggle('site-header__pill--scrolled', window.scrollY > 0);
  };
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });

  // Some visitors have no mail client registered for mailto:, so clicking
  // "Contact me" silently does nothing. Show the address in a small popover
  // with a copy button instead of relying on the OS to handle the link.
  const trigger = document.querySelector<HTMLAnchorElement>('#contact-trigger');
  const popover = document.querySelector<HTMLElement>('#contact-popover');
  const closeBtn = popover?.querySelector<HTMLButtonElement>('.contact-popover__close');
  const copyBtn = popover?.querySelector<HTMLButtonElement>('.contact-popover__copy');
  const input = popover?.querySelector<HTMLInputElement>('.contact-popover__input');

  const openPopover = () => {
    popover?.removeAttribute('hidden');
  };
  const closePopover = () => {
    popover?.setAttribute('hidden', '');
  };

  trigger?.addEventListener('click', (event) => {
    event.preventDefault();
    if (popover?.hasAttribute('hidden')) {
      openPopover();
    } else {
      closePopover();
    }
  });

  closeBtn?.addEventListener('click', closePopover);

  copyBtn?.addEventListener('click', async () => {
    const email = input?.value ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      input?.select();
      document.execCommand('copy');
    }
    const original = copyBtn.textContent;
    copyBtn.textContent = 'Copied';
    setTimeout(() => {
      copyBtn.textContent = original;
    }, 1500);
  });

  document.addEventListener('click', (event) => {
    if (!popover || popover.hasAttribute('hidden')) return;
    const target = event.target as Node;
    if (popover.contains(target) || trigger?.contains(target)) return;
    closePopover();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePopover();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: var(--size-16);
  }

  .site-header__pill {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--size-8);
    padding: var(--size-8);
    background: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    transition: background-color var(--motion-fast) var(--motion-ease), border-color var(--motion-fast) var(--motion-ease);
  }

  /* Scroll state: frosted 10%-white overlay with a real backdrop blur,
     matching the Header component's Scroll variant in Figma. */
  .site-header__pill--scrolled {
    background: var(--white-a10);
    border-color: var(--white-a10);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--size-8);
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-control);
  }

  .site-header__name {
    font-size: var(--text-logo);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  /* Mobile: nav collapses behind the burger */
  .site-header__nav {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--size-24);
    width: 100%;
    padding: var(--size-16) var(--size-8) 0;
  }

  .site-header__link {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .site-header__link:hover {
    color: var(--color-text-muted);
  }

  /* Contact button is the accent Button component (orange fill, white
     label) everywhere it appears — not an inverted light/dark swap. */
  .site-header__contact {
    display: none;
    padding: var(--size-8) var(--size-16);
    background: var(--color-accent);
    color: var(--color-text-primary);
    border-radius: var(--radius-control);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--motion-fast) var(--motion-ease);
  }

  .site-header__contact:hover {
    opacity: 0.8;
  }

  .site-header__contact-wrap {
    position: relative;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .site-header__contact-wrap {
      width: auto;
    }
  }

  .contact-popover {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    z-index: 60;
    width: 260px;
    max-width: calc(100vw - 32px);
    display: flex;
    flex-direction: column;
    gap: var(--size-8);
    padding: var(--size-16);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .contact-popover__caret {
    position: absolute;
    top: -6px;
    right: 18px;
    width: 12px;
    height: 12px;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border-subtle);
    border-top: 1px solid var(--color-border-subtle);
    transform: rotate(45deg);
    border-radius: 2px 0 0 0;
  }

  .contact-popover__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contact-popover__label {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-popover__close {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-control);
    color: var(--color-text-muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .contact-popover__close:hover {
    color: var(--color-text-primary);
  }

  .contact-popover__row {
    display: flex;
    gap: var(--size-8);
  }

  .contact-popover__input {
    flex: 1 0 0;
    min-width: 0;
    padding: var(--size-8) var(--size-12);
    background: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    color: var(--color-text-primary);
    font-size: var(--text-label);
    font-family: inherit;
  }

  .contact-popover__copy {
    flex: none;
    padding: var(--size-8) var(--size-16);
    background: var(--color-accent);
    color: var(--color-text-primary);
    border: 0;
    border-radius: var(--radius-control);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: opacity var(--motion-fast) var(--motion-ease);
  }

  .contact-popover__copy:hover {
    opacity: 0.8;
  }

  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-control);
    color: inherit;
    cursor: pointer;
    flex-shrink: 0;
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--motion-fast) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease), top var(--motion-fast) var(--motion-ease);
  }

  .site-header__burger {
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -6px;
  }

  .site-header__burger::after {
    top: 6px;
  }

  /* Open state on mobile: the pill becomes a full-screen overlay — brand +
     close icon on top, the nav list stacked below, and the Contact button
     pinned to the bottom edge — matching the Mobile/Scroll/Opened=True
     variant in Figma rather than a small dropdown under the pill. */
  @media (max-width: 1023px) {
    .site-header__pill--open {
      position: fixed;
      inset: 0;
      height: 100dvh;
      padding: 34px var(--size-16) var(--size-16);
      border-radius: 0;
      border: none;
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header__pill--open .site-header__nav {
      display: flex;
    }

    .site-header__pill--open .site-header__contact-wrap {
      margin-top: auto;
    }

    .site-header__pill--open .site-header__contact {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: var(--size-16);
    }

    .site-header__pill--open .site-header__burger {
      background: transparent;
    }

    .site-header__pill--open .site-header__burger::before {
      top: 0;
      transform: rotate(45deg);
    }

    .site-header__pill--open .site-header__burger::after {
      top: 0;
      transform: rotate(-45deg);
    }
  }

  @media (min-width: 1024px) {
    .site-header__pill {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .site-header__row {
      width: auto;
    }

    .site-header__nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      width: auto;
      padding: 0;
    }

    .site-header__contact {
      display: inline-flex;
      align-items: center;
    }

    .site-header__toggle {
      display: none;
    }
  }
</style>
