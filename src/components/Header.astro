---
const navLinks = [
  { label: 'Work', href: '/#work' },
  { label: 'Experiments', href: '/#experiments' },
  { label: 'Writing', href: '/#writing' },
  { label: 'Download CV', href: '/Belkova_Iryna_CV_EN.pdf' },
];
---

<header class="site-header">
  <div class="container">
    <div class="site-header__pill">
      <div class="site-header__row">
        <a class="site-header__brand" href="/">
          <img class="site-header__logo" src="/images/logo.svg" alt="" width="36" height="36" />
          <span class="site-header__name">Belkova Iryna</span>
        </a>

        <button
          class="site-header__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <span class="site-header__burger" aria-hidden="true"></span>
        </button>
      </div>

      <nav class="site-header__nav" id="site-nav" aria-label="Main">
        {
          navLinks.map((link) => (
            <a class="site-header__link" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>

      <a class="site-header__contact" href="#footer">Contact me</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const pill = document.querySelector<HTMLElement>('.site-header__pill');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    pill?.classList.toggle('site-header__pill--open', !open);
  });

  const updateScrolled = () => {
    pill?.classList.toggle('site-header__pill--scrolled', window.scrollY > 0);
  };
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: var(--size-16);
  }

  .site-header__pill {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--size-8);
    padding: var(--size-8);
    background: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    transition: background-color var(--motion-fast) var(--motion-ease), border-color var(--motion-fast) var(--motion-ease);
  }

  /* Scroll state: frosted 10%-white overlay with a real backdrop blur,
     matching the Header component's Scroll variant in Figma. */
  .site-header__pill--scrolled {
    background: var(--white-a10);
    border-color: var(--white-a10);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--size-8);
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-control);
  }

  .site-header__name {
    font-size: var(--text-logo);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  /* Mobile: nav collapses behind the burger */
  .site-header__nav {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--size-24);
    width: 100%;
    padding: var(--size-16) var(--size-8) 0;
  }

  .site-header__link {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .site-header__link:hover {
    color: var(--color-text-muted);
  }

  /* Contact button is the accent Button component (orange fill, white
     label) everywhere it appears — not an inverted light/dark swap. */
  .site-header__contact {
    display: none;
    padding: var(--size-8) var(--size-16);
    background: var(--color-accent);
    color: var(--color-text-primary);
    border-radius: var(--radius-control);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-component);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--motion-fast) var(--motion-ease);
  }

  .site-header__contact:hover {
    opacity: 0.8;
  }

  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-control);
    color: inherit;
    cursor: pointer;
    flex-shrink: 0;
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--motion-fast) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease), top var(--motion-fast) var(--motion-ease);
  }

  .site-header__burger {
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -6px;
  }

  .site-header__burger::after {
    top: 6px;
  }

  /* Open state on mobile: the pill becomes a full-screen overlay — brand +
     close icon on top, the nav list stacked below, and the Contact button
     pinned to the bottom edge — matching the Mobile/Scroll/Opened=True
     variant in Figma rather than a small dropdown under the pill. */
  @media (max-width: 1023px) {
    .site-header__pill--open {
      position: fixed;
      inset: 0;
      height: 100dvh;
      padding: 34px var(--size-16) var(--size-16);
      border-radius: 0;
      border: none;
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header__pill--open .site-header__nav {
      display: flex;
    }

    .site-header__pill--open .site-header__contact {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      margin-top: auto;
      padding: var(--size-16);
    }

    .site-header__pill--open .site-header__burger {
      background: transparent;
    }

    .site-header__pill--open .site-header__burger::before {
      top: 0;
      transform: rotate(45deg);
    }

    .site-header__pill--open .site-header__burger::after {
      top: 0;
      transform: rotate(-45deg);
    }
  }

  @media (min-width: 1024px) {
    .site-header__pill {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .site-header__row {
      width: auto;
    }

    .site-header__nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      width: auto;
      padding: 0;
    }

    .site-header__contact {
      display: inline-flex;
      align-items: center;
    }

    .site-header__toggle {
      display: none;
    }
  }
</style>
